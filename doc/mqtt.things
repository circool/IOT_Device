Bridge mqtt:broker:local [ 
  host=localhost, 
  secure=false, 
  username=openhabian, 
  password=MQTT_PASSWORD
] {

  Thing topic fan_0F7C "Вентилятор ванная" [ availabilityTopic="fan_0F7C/status", payloadAvailable="Online", payloadNotAvailable="Offline" ] {  
    Channels:
      Type switch : status "Состояние" [ 
        stateTopic="fan_0F7C/status", on="Online", off="Offline"
      ]

      Type switch : fan_state "Вытяжка" [ 
        stateTopic="fan_0F7C/fan/state", on="ON", off="OFF",
        commandTopic="fan_0F7C/c/fan/state", on="1", off="0"
      ]

      Type number : sensor_humidity "Влажность" [ 
        stateTopic="fan_0F7C/sensor/humidity",
	unit="%"
      ]
      
      Type number : sensor_lowHum "Low Humidity Range" [ 
        stateTopic="fan_0F7C/sensor/lowHum",
        commandTopic="fan_0F7C/c/sensor/lowHum",
        min=0, max=100, unit="%"
      ]

      Type number : sensor_highHum "High Humidity Range" [ 
        stateTopic="fan_0F7C/sensor/highHum",
        commandTopic="fan_0F7C/c/sensor/highHum",
        min=0, max=100, unit="%"
      ]

      Type number : sensor_temperature "Температура" [ 
        stateTopic="fan_0F7C/sensor/temperature"
      ]

      Type number : sensor_lowTemp "Low Temperature Range" [ 
        stateTopic="fan_0F7C/sensor/lowTemp",
        commandTopic="fan_0F7C/c/sensor/lowTemp",
        min=-50, max=50, unit="°C"
      ]

      Type number : sensor_highTemp "High Temperature Range" [ 
        stateTopic="fan_0F7C/sensor/highTemp",
        commandTopic="fan_0F7C/c/sensor/highTemp",
        min=-50, max=50, unit="°C"
      ]

      Type number : fan_delaySec "Fan delay" [ 
        stateTopic="fan_0F7C/fan/delaySec",
        commandTopic="fan_0F7C/c/fan/delaySec",
        min=0, unit="sec"
      ]

      Type switch : fan_slowMode "Slow Mode" [ 
        stateTopic="fan_0F7C/fan/slowMode", on="1", off="0",
        commandTopic="fan_0F7C/c/fan/slowMode", on="1", off="0"
      ]

      Type number : fan_slowModeDuty "Slow Mode Duty" [ 
        stateTopic="fan_0F7C/fan/slowModeDuty",
        commandTopic="fan_0F7C/c/fan/slowModeDuty",
        min=0, max=255
      ]

      Type switch : fan_autoMode "Auto Mode" [ 
        stateTopic="fan_0F7C/fan/autoMode", on="1", off="0",
        commandTopic="fan_0F7C/c/fan/autoMode", on="1", off="0"
      ]
  }

  Thing topic fan_1F32 "Вентилятор туалет" [ availabilityTopic="fan_1F32/status", payloadAvailable="Online", payloadNotAvailable="Offline" ] {  
    Channels:
      Type switch : status "Состояние" [ 
        stateTopic="fan_1F32/status", on="Online", off="Offline"
      ]

      Type switch : fan_state "Вытяжка" [ 
        stateTopic="fan_1F32/fan/state", on="ON", off="OFF",
        commandTopic="fan_1F32/c/fan/state", on="1", off="0"
      ]

      Type number : sensor_humidity "Влажность" [ 
        stateTopic="fan_1F32/sensor/humidity",
	      unit="%"
      ]
      
      Type number : sensor_lowHum "Low Humidity Range" [ 
        stateTopic="fan_1F32/sensor/lowHum",
        commandTopic="fan_1F32/c/sensor/lowHum",
        min=0, max=100, unit="%"
      ]

      Type number : sensor_highHum "High Humidity Range" [ 
        stateTopic="fan_1F32/sensor/highHum",
        commandTopic="fan_1F32/c/sensor/highHum",
        min=0, max=100, unit="%"
      ]

      Type number : sensor_temperature "Температура" [ 
        stateTopic="fan_1F32/sensor/temperature"
      ]

      Type number : sensor_lowTemp "Low Temperature Range" [ 
        stateTopic="fan_1F32/sensor/lowTemp",
        commandTopic="fan_1F32/c/sensor/lowTemp",
        min=-50, max=50, unit="°C"
      ]

      Type number : sensor_highTemp "High Temperature Range" [ 
        stateTopic="fan_1F32/sensor/highTemp",
        commandTopic="fan_1F32/c/sensor/highTemp",
        min=-50, max=50, unit="°C"
      ]

      Type number : fan_delaySec "Fan delay" [ 
        stateTopic="fan_1F32/fan/delaySec",
        commandTopic="fan_1F32/c/fan/delaySec",
        min=0, unit="sec"
      ]

      Type switch : fan_slowMode "Slow Mode" [ 
        stateTopic="fan_1F32/fan/slowMode", on="1", off="0",
        commandTopic="fan_1F32/c/fan/slowMode", on="1", off="0"
      ]

      Type number : fan_slowModeDuty "Slow Mode Duty" [ 
        stateTopic="fan_1F32/fan/slowModeDuty",
        commandTopic="fan_1F32/c/fan/slowModeDuty",
        min=0, max=255
      ]

      Type switch : fan_autoMode "Auto Mode" [ 
        stateTopic="fan_1F32/fan/autoMode", on="1", off="0",
        commandTopic="fan_1F32/c/fan/autoMode", on="1", off="0"
      ]
  }
}