    channel="mqtt:topic:local:fan_1F32:sensor_humidity" 
}

Number:Temperature fan_1F32_sensor_temperature "Температура [%.2f °C]" <temperature> (gFan1F32,loc_Toilet,gTemperatures) ["Measurement","Temperature"] {
    channel="mqtt:topic:local:fan_1F32:sensor_temperature"
}

Number fan_1F32_sensor_lowHum "Low Humidity [%.2f %%]" <humidity> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:sensor_lowHum"
}

Number fan_1F32_sensor_highHum "High Humidity [%.2f %%]" <humidity> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:sensor_highHum"
}

Number fan_1F32_sensor_lowTemp "Low Temperature [%.2f °C]" <temperature_cold> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:sensor_lowTemp"
}

Number fan_1F32_sensor_highTemp "High Temperature [%.2f °C]" <temperature_hot> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:sensor_highTemp"
}

Number fan_1F32_fan_delaySec "Fan delay [%d sec]" <clock> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:fan_delaySec"
}

Switch fan_1F32_fan_slowMode "Slow Mode" <oh:switch> (gFan1F32,loc_Toilet) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_1F32:fan_slowMode"
}

Number fan_1F32_fan_slowModeDuty "Slow Mode Duty [%d]" <slider> (gFan1F32,loc_Toilet) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_1F32:fan_slowModeDuty"
}

Switch fan_1F32_fan_autoMode "Auto Mode" <oh:switch> (gFan1F32,loc_Toilet) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_1F32:fan_autoMode"
}