// ==================== TYPE 1: Вентилятор с датчиком ====================
// Client ID: fan_esp32

Group   gFan0F7C "Вентилятор 0F7C"    <fan> (loc_Bathroom,g_Sensors) ["Fan"]
Group   gFan1F32 "Вентилятор 1F32"    <fan> (loc_Toilet,g_Sensors) ["Fan"]

Switch fan_0F7C_status "Статус подключения" <f7:antenna_radiowaves_left_right> (gFan0F7C) ["Status"] {
    channel="mqtt:topic:local:fan_0F7C:status", on="Online", off="Offline"
}


Switch fan_0F7C_fan_state "Вытяжка" <oh:switch> (gFan0F7C,loc_Bathroom) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_0F7C:fan_state"
}

Number:Dimensionless fan_0F7C_sensor_humidity "Влажность [%.1f %%]" <humidity> (gFan0F7C,loc_Bathroom,gHumidities) ["Measurement","Humidity"] { 
    channel="mqtt:topic:local:fan_0F7C:sensor_humidity" 
}

Number:Temperature fan_0F7C_sensor_temperature "Температура [%.2f °C]" <temperature> (gFan0F7C,loc_Bathroom,gTemperatures) ["Measurement","Temperature"] {
    channel="mqtt:topic:local:fan_0F7C:sensor_temperature"
}

Number fan_0F7C_sensor_lowHum "Low Humidity [%.2f %%]" <humidity> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:sensor_lowHum"
}

Number fan_0F7C_sensor_highHum "High Humidity [%.2f %%]" <humidity> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:sensor_highHum"
}

Number fan_0F7C_sensor_lowTemp "Low Temperature [%.2f °C]" <temperature_cold> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:sensor_lowTemp"
}

Number fan_0F7C_sensor_highTemp "High Temperature [%.2f °C]" <temperature_hot> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:sensor_highTemp"
}

Number fan_0F7C_fan_delaySec "Fan delay [%d sec]" <clock> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:fan_delaySec"
}

Switch fan_0F7C_fan_slowMode "Slow Mode" <oh:switch> (gFan0F7C,loc_Bathroom) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_0F7C:fan_slowMode"
}

Number fan_0F7C_fan_slowModeDuty "Slow Mode Duty [%d]" <slider> (gFan0F7C,loc_Bathroom) ["Fan","Setpoint"] {
    channel="mqtt:topic:local:fan_0F7C:fan_slowModeDuty"
}

Switch fan_0F7C_fan_autoMode "Auto Mode" <oh:switch> (gFan0F7C,loc_Bathroom) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_0F7C:fan_autoMode"
}


Switch fan_1F32_status "Статус подключения" <f7:antenna_radiowaves_left_right> (gFan1F32) ["Status"] {
    channel="mqtt:topic:local:fan_1F32:status", on="Online", off="Offline"
}

Switch fan_1F32_fan_state "Вытяжка" <oh:switch> (gFan1F32,loc_Toilet) ["Fan","Switch"] {
    channel="mqtt:topic:local:fan_1F32:fan_state"
}

